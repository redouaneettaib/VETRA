# Base de données PostgreSQL et session
DATABASE_URL=
SESSION_SECRET=

# Authentification OTP par e-mail (true par défaut en production)
REQUIRE_LOGIN_OTP=true

# Messagerie option 1 : Resend HTTPS (recommandé sur Railway / Vercel)
RESEND_API_KEY=
RESEND_FROM=

# Messagerie option 2 : Serveur SMTP (utilisé si RESEND_API_KEY est vide)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=

# Analyse et veille IA (Direction centrale — côté serveur uniquement)
GEMINI_API_KEY=

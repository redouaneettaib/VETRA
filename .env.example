# Base de données PostgreSQL et session
DATABASE_URL=
SESSION_SECRET=

# Authentification OTP par e-mail (true par défaut en production)
REQUIRE_LOGIN_OTP=true

# Messagerie option 1 : Brevo HTTPS (recommandé sur Railway, sans domaine DNS requis)
BREVO_API_KEY=
BREVO_FROM=

# Messagerie option 2 : Resend HTTPS (avec domaine vérifié)
RESEND_API_KEY=
RESEND_FROM=

# Messagerie option 3 : Serveur SMTP (utilisé si Brevo et Resend sont vides)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASS=

# Analyse et veille IA (Direction centrale — côté serveur uniquement)
GEMINI_API_KEY=

# Mot de passe des comptes fictifs de présentation (npm run db:seed:demo, 12 caractères min.)
DEMO_USER_PASSWORD=

